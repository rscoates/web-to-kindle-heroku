doctype html
html
  head
    title Kindle dashboard
    meta(name="viewport" content="width=800, initial-scale=1")
    style
      include ../public/kindle.css
  body
    .wrapper
      .weather-widget
        a.weatherwidget-io(href="https://forecast7.com/en/51d51n0d30/ealing/" data-label_1="EALING" data-label_2="WEATHER TODAY" data-days="5" data-font="Arial" data-theme="pure")
      .dashboard-content
        .panel.trains-widget
          h2 Trains
          .trains-info.trains-heading
            .departure West Ealing
            .arrival TCR
          each train in trains.slice(0, 3)
            .trains-info.train-row
              .departure
                .scheduled= train.departureScheduled
                .actual= train.departureDue
              .arrival
                .scheduled= train.arrivalScheduled
                .actual= train.arrivalDue
          if !trains.length
            p No upcoming trains
        .panel.recycling-widget
          h2 Bins
          p.emboldened= recycling.date
          p= recycling.types
        .panel.reminders-widget
          h2 Reminders
          each reminder in reminders
            .reminder
              p.emboldened= reminder.date
              p= reminder.text
          if !reminders.length
            p No upcoming reminders
      .date-widget Updated #{date}
    script !function(d,s,id){var js,fjs=d.getElementsByTagName(s)[0];if(!d.getElementById(id)){js=d.createElement(s);js.id=id;js.src='https://weatherwidget.io/js/widget.min.js';fjs.parentNode.insertBefore(js,fjs);}}(document,'script','weatherwidget-io-js');
